# Copy this file to backend/.env and fill in your own values:
#   cp backend/env.example backend/.env
#
# backend/.env is gitignored - never commit real keys or secrets.
#
# Every setting below is optional: app/core/config.py has a working default for
# each, so the API starts with no .env at all. Set them when you want something
# other than the local prototype defaults.

# Signs the JWTs issued by /auth/login. The checked-in default is a public
# placeholder, so anyone reading this repo can mint a valid token against it.
# Generate your own before this is reachable by anyone outside the team:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Where the case store lives. Defaults to a local SQLite file at
# backend/spemass.db, which is gitignored and reseeded on every startup.
# Example for Postgres: postgresql+psycopg://user:pass@localhost:5432/spemass
DATABASE_URL=

# Optional. When set, the Universal AI Investigator sends its retrieved evidence
# context to Google Gemini to phrase the answer. Left blank, the planner answers
# deterministically from the same retrieved records - every feature still works,
# the wording is just templated rather than generated.
GEMINI_API_KEY=
