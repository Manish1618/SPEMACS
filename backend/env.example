# Copy this file to backend/.env and fill in your own values:
#   cp backend/env.example backend/.env
#
# backend/.env is gitignored - never commit real keys or secrets.
#
# Every setting below has a working default in app/core/config.py, so the API
# starts with no .env at all *in demo mode*. Running with DEMO_MODE=false
# requires SECRET_KEY, and the app refuses to start without it.

# --- Deployment posture -----------------------------------------------------

# true  : seeds the four synthetic investigator accounts on startup and lets the
#         login screen advertise their passwords. Local development only.
# false : seeds no accounts at all. Create the first administrator with
#         `cd backend && python create_admin.py`, then provision everyone else
#         from the Access Control tab.
DEMO_MODE=true

# Signs the JWTs issued by /auth/login. The old checked-in default is a public
# placeholder and is now rejected outright. In demo mode, leaving this blank
# generates an ephemeral key per process (every session drops on restart);
# with DEMO_MODE=false the app will not start without a real one. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Sessions ---------------------------------------------------------------

# The browser holds the access token in memory only and silently renews it from
# the refresh cookie, so a short lifetime costs nothing.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set to true behind HTTPS so the refresh cookie is never sent in the clear.
# Left false for localhost, where there is no TLS to attach it to.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# Comma-separated list of browser origins allowed to call the API. A wildcard is
# not accepted: credentialed requests carry the refresh cookie.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Brute-force controls ---------------------------------------------------

# An account locks for LOGIN_LOCKOUT_MINUTES after this many failed sign-ins.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Per-IP throttle on /auth/login, on top of the per-account lockout above.
# Counters are per-process; behind multiple workers each enforces its own.
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_IP_WINDOW_SECONDS=300

# Minimum length for any password set through /users or /auth/change-password.
MIN_PASSWORD_LENGTH=12

# --- Storage and integrations -----------------------------------------------

# PostgreSQL is the supported store. The schema is managed by Alembic and
# upgraded automatically at startup.
#   postgresql+psycopg://spemass_app:PASSWORD@127.0.0.1:5432/spemass
# SQLite still works for a throwaway local run:
#   sqlite:///spemass.db
DATABASE_URL=

# Optional. When set, the Universal AI Investigator sends its retrieved evidence
# context to Google Gemini to phrase the answer. Left blank, the planner answers
# deterministically from the same retrieved records - every feature still works,
# the wording is just templated rather than generated.
GEMINI_API_KEY=

# --- Access alerting --------------------------------------------------------
# Every access event is written to the audit log regardless of these settings.
# These control only what is pushed out to the Crime Branch head.

ALERTS_ENABLED=true

# Which events go to each channel. "*" means all. Email carries the full record;
# SMS is reserved for events worth interrupting someone for, because SMS costs
# per message. Set ALERT_SMS_EVENTS=* to text on everything.
ALERT_EMAIL_EVENTS=*
ALERT_SMS_EVENTS=LOGIN_LOCKED,LOGIN_THROTTLED,PRIVILEGED_LOGIN,CREATE_USER,UPDATE_USER,RESET_USER_PASSWORD,REVOKE_USER_SESSIONS,UPDATE_CASE_TEAM

# A sign-in by one of these roles escalates to SMS.
ALERT_PRIVILEGED_ROLES=ADMIN,LEAD_INVESTIGATOR

# Alerts go to whoever holds the CRIME_BRANCH_HEAD role, using the email and
# phone_number on their user record. These are the backstop used only when
# nobody holds the role, so an alert is never silently dropped.
ALERT_FALLBACK_EMAIL=
ALERT_FALLBACK_PHONE=

# --- Email transport --------------------------------------------------------
# With SMTP_HOST unset, email alerts are logged and recorded as SKIPPED, so the
# whole path works with no account to sign up for.
#
# Gmail needs an App Password (16 characters), NOT your login password: enable
# 2-Step Verification, then generate one at https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SPEMASS Access Control <no-reply@spemass.example>

# --- SMS transport ----------------------------------------------------------
# console (default, logs only) | twilio | msg91
SMS_PROVIDER=console

# Sender number in E.164 for Twilio, or the registered sender ID for MSG91.
SMS_FROM=

# Twilio. On a trial account the destination number must be verified first.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# MSG91 (India). Requires DLT sender-ID registration before it will deliver.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
